---
import { LEADER_QUOTE } from '../data/content';
---
<section class="bg-ink border-b-2 border-ink py-16">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 lg:grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-9">
      <div class="label text-[11px] text-primary/70 mb-6">SLOVO LÍDRA</div>
      <blockquote class="h-display text-paper" style="font-size:clamp(28px, 3.8vw, 52px)">
        „{LEADER_QUOTE}”
      </blockquote>
      <div class="mt-8 flex items-center gap-4">
        <div class="w-12 h-[3px] bg-primary"></div>
        <div>
          <div class="h-display text-[16px] text-paper">[JMÉNO KANDIDÁTA]</div>
          <div class="label text-[10px] text-primary/70 mt-1">LÍDR KANDIDÁTKY</div>
        </div>
      </div>
    </div>
    <div class="hidden lg:flex lg:col-span-3 items-center justify-center">
      <div class="h-display text-primary/20 select-none leading-none" style="font-size:clamp(80px,10vw,140px)">”</div>
    </div>
  </div>
</section>
