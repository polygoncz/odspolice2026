---
---
<section class="bg-paper border-b-2 border-ink py-20">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
    <div class="flex items-end justify-between gap-6 mb-10 flex-wrap">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-block w-10 h-[3px] bg-primary"></span>
          <span class="label text-[12px] text-secondary">NÁŠ TÝM</span>
        </div>
        <h2 class="h-display text-ink" style="font-size:clamp(36px, 5vw, 64px)">
          21&nbsp;OSOBNOSTÍ<br/>PRO&nbsp;POLICI
        </h2>
      </div>
      <div class="bg-primary text-ink border-2 border-ink px-5 py-3">
        <div class="label text-[10px]">SKUPINOVÁ FOTOGRAFIE</div>
        <div class="h-display text-[18px] mt-1">[KVĚTEN 2026]</div>
      </div>
    </div>

    <div class="relative">
      <div class="absolute bg-ink" style="inset:0;transform:translate(14px,14px)"></div>
      <div class="relative bg-ink border-2 border-ink overflow-hidden" style="aspect-ratio:16/7">
        <img
          src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=1800&h=800&fit=crop&q=85"
          alt="[Skupinová fotografie týmu]"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:grayscale(0.1) contrast(1.05)"
        />
        <div class="absolute top-0 left-0 bg-primary text-ink px-4 py-2 border-r-2 border-b-2 border-ink z-10">
          <div class="label text-[10px]">[PLACEHOLDER — NAHRADIT REÁLNOU FOTKOU]</div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 bg-ink/85 text-paper px-6 py-4 border-t-2 border-primary z-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="label text-[10px] text-primary">KANDIDÁTKA 2026</div>
            <div class="h-display text-[22px] leading-tight mt-1 text-paper">[POPISEK FOTKY — KDO, KDY, KDE]</div>
          </div>
          <a href="#kandidati" class="label text-[11px] text-primary border-b-2 border-primary pb-1 hover:text-paper hover:border-paper">
            Celý tým →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
