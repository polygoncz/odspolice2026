---
import { NAV, FOOTER_ABOUT, CONTACT_ADDRESS, CONTACT_EMAIL, CONTACT_PHONE, CONTACT_ACCOUNT } from '../data/content';
---
<footer id="kontakt" class="bg-ink text-paper">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 pt-20 pb-10">
    <div class="grid lg:grid-cols-12 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-6">
          <!-- Mark: koaliční dvojblok, inversní pro tmavé pozadí -->
          <div class="flex items-stretch" style="gap:3px;height:52px;flex:none">
            <div class="flex flex-col items-center justify-end" style="width:22px;padding-bottom:6px;background:#39D4D8">
              <span class="h-display" style="font-size:7px;color:#002D52;letter-spacing:0.04em">ODS</span>
            </div>
            <div style="width:30px;background:rgba(57,212,216,0.28)"></div>
          </div>
          <!-- Text -->
          <div class="leading-none">
            <div class="h-display text-paper" style="font-size:22px">ODS A NEZÁVISLÍ</div>
            <div class="h-display" style="font-size:14px;color:#39D4D8;margin-top:3px">POLICE 2026</div>
          </div>
        </div>
        <p class="text-[14px] leading-[1.6] text-paper/75 max-w-[420px]">{FOOTER_ABOUT}</p>
        <div class="mt-8 grid grid-cols-2 max-w-[200px] border-2 border-primary">
          {(['FB','IG'] as const).map((s, i) => (
            <a href="#" class={`label text-[12px] py-3 text-center text-paper hover:bg-primary hover:text-ink ${i < 1 ? 'border-r-2 border-primary' : ''}`}>{s}</a>
          ))}
        </div>
      </div>

      <!-- Nav + Docs -->
      <div class="lg:col-span-3">
        <div class="label text-[10px] text-primary mb-5">STRÁNKY</div>
        <ul class="space-y-3 text-[14px]">
          {NAV.map(n => <li><a href={`#${n.id}`} class="hover:text-primary">{n.label}</a></li>)}
        </ul>
        <div class="label text-[10px] text-primary mt-8 mb-5">DOKUMENTY</div>
        <ul class="space-y-3 text-[14px]">
          <li><a class="hover:text-primary" href="#">Program (PDF)</a></li>
          <li><a class="hover:text-primary" href="#">Stanovy</a></li>
          <li><a class="hover:text-primary" href="#">GDPR</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-4">
        <div class="label text-[10px] text-primary mb-5">KONTAKT</div>
        <ul class="space-y-5 text-[14px]">
          <li>
            <div class="label text-[10px] text-paper/50">ADRESA</div>
            <div class="mt-1 text-paper">{CONTACT_ADDRESS}</div>
          </li>
          <li>
            <div class="label text-[10px] text-paper/50">E-MAIL</div>
            <a href={`mailto:${CONTACT_EMAIL}`} class="mt-1 text-paper hover:text-primary block">{CONTACT_EMAIL}</a>
          </li>
          <li>
            <div class="label text-[10px] text-paper/50">TELEFON</div>
            <a href={`tel:${CONTACT_PHONE.replace(/\s/g,'')}`} class="mt-1 text-paper hover:text-primary block">{CONTACT_PHONE}</a>
          </li>
          <li>
            <div class="label text-[10px] text-paper/50">TRANSPARENTNÍ ÚČET</div>
            <a href="#" class="mt-1 text-paper hover:text-primary block">{CONTACT_ACCOUNT}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-6 border-t-2 border-primary/40 flex flex-wrap items-center justify-between gap-4 label text-[10px] text-paper/60">
      <div>© 2026 ODS POLICE — VŠECHNA PRÁVA VYHRAZENA</div>
      <div class="flex gap-6">
        <a href="#" class="hover:text-primary">VOLEBNÍ KOMISE</a>
        <a href="#" class="hover:text-primary">ZADAVATEL: ODS POLICE</a>
        <a href="#" class="hover:text-primary">ZPRACOVATEL: [—]</a>
      </div>
    </div>
  </div>
</footer>
