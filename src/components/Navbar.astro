---
import { NAV } from '../data/content';
---
<header class="sticky top-0 z-40 bg-primary border-b-2 border-ink">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 flex items-center justify-between" style="height:76px">
    <a href="#top" class="flex items-center">
      <!-- LogoMark inlined -->
      <div class="flex items-center gap-3">
        <!-- Mark: koaliční dvojblok -->
        <div class="flex items-stretch" style="gap:3px;height:44px;flex:none">
          <div class="bg-ink flex flex-col items-center justify-end" style="width:18px;padding-bottom:5px">
            <span class="h-display text-primary" style="font-size:6px;letter-spacing:0.04em">ODS</span>
          </div>
          <div style="width:26px;background:rgba(0,45,82,0.28)"></div>
        </div>
        <!-- Text -->
        <div class="leading-none">
          <div class="h-display text-ink" style="font-size:18px">ODS A NEZÁVISLÍ</div>
          <div class="h-display text-ink" style="font-size:11px;margin-top:2px">POLICE 2026</div>
          <div class="label text-ink/60" style="font-size:8px;margin-top:3px">KOMUNÁLNÍ&nbsp;VOLBY</div>
        </div>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {NAV.map(n => (
        <a href={`#${n.id}`} data-nav-id={n.id} class="nav-link label text-[12px] text-ink">{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button id="menu-toggle" type="button" class="md:hidden w-11 h-11 bg-ink text-primary flex items-center justify-center"
              aria-label="Menu" aria-controls="mobile-nav" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" data-icon="open">
          <rect x="2" y="4"  width="18" height="2" fill="currentColor"/>
          <rect x="2" y="10" width="18" height="2" fill="currentColor"/>
          <rect x="2" y="16" width="18" height="2" fill="currentColor"/>
        </svg>
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" data-icon="close" class="hidden">
          <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="2"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="md:hidden hidden border-t-2 border-ink bg-primary">
    {NAV.map(n => (
      <a href={`#${n.id}`} class="label text-[13px] text-ink block px-6 py-5 border-b-2 border-ink/15 last:border-b-0 hover:bg-ink hover:text-primary">{n.label}</a>
    ))}
  </nav>
</header>

<script>
  const sections = ['priority','kandidati','program'];
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-id]');

  function setActive() {
    const y = window.scrollY + 200;
    let cur = '';
    for (const id of sections) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) cur = id;
    }
    links.forEach(a => {
      a.classList.toggle('is-active', a.dataset.navId === cur);
    });
  }

  window.addEventListener('scroll', setActive, { passive: true });
  setActive();

  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const panel  = document.getElementById('mobile-nav');

  function setMenu(open: boolean) {
    if (!toggle || !panel) return;
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setMenu(panel?.classList.contains('hidden') ?? false);
  });
  panel?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });
</script>
