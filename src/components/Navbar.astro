---
import { NAV } from '../data/content';
---
<header class="sticky top-0 z-40 bg-primary border-b-2 border-ink">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 flex items-center justify-between" style="height:76px">
    <a href="#top" class="flex items-center">
      <!-- LogoMark inlined -->
      <div class="flex items-center gap-3">
        <div class="relative" style="width:44px;height:44px">
          <div class="absolute inset-0 bg-ink"></div>
          <div class="absolute" style="left:18%;top:18%;width:64%;height:64%;background:#39D4D8"></div>
          <div class="absolute h-display text-ink leading-none" style="left:50%;top:50%;transform:translate(-50%,-52%);font-size:18.5px;font-weight:700">ODS</div>
        </div>
        <div class="leading-none">
          <div class="h-display text-ink" style="font-size:18px">POLICE 2026</div>
          <div class="label text-ink/70" style="font-size:9px;margin-top:3px">KOMUNÁLNÍ&nbsp;VOLBY</div>
        </div>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {NAV.map(n => (
        <a href={`#${n.id}`} data-nav-id={n.id} class="nav-link label text-[12px] text-ink">{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button class="md:hidden w-11 h-11 bg-ink text-primary flex items-center justify-center" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <rect x="2" y="4"  width="18" height="2" fill="currentColor"/>
          <rect x="2" y="10" width="18" height="2" fill="currentColor"/>
          <rect x="2" y="16" width="18" height="2" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const sections = ['program','kandidati','aktuality','akce','kontakt'];
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-id]');

  function setActive() {
    const y = window.scrollY + 200;
    let cur = '';
    for (const id of sections) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) cur = id;
    }
    links.forEach(a => {
      a.classList.toggle('is-active', a.dataset.navId === cur);
    });
  }

  window.addEventListener('scroll', setActive, { passive: true });
  setActive();
</script>
