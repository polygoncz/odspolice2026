---
import { Image } from 'astro:assets';
import { TEAM_PHOTO, HERO_HEADLINE_HTML, HERO_SUBTITLE } from '../data/content';
---
<section id="top" class="relative bg-primary border-b-2 border-ink overflow-hidden">
  <div class="absolute inset-0 grid-lines pointer-events-none"></div>

  <div class="absolute hidden lg:block" style="right:-100px;bottom:-40px;width:340px;height:220px;background:#26A9AE"></div>
  <div class="absolute hidden lg:block" style="right:240px;bottom:-40px;width:14px;height:220px;background:#002D52"></div>

  <div class="relative max-w-[1280px] mx-auto px-6 lg:px-10 pt-16 pb-24 lg:pt-24 lg:pb-32 grid lg:grid-cols-12 gap-10 items-end">

    <!-- Left: headline -->
    <div class="lg:col-span-7 relative">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-block w-10 h-[3px] bg-ink"></span>
        <span class="label text-[12px] text-ink/80">VOLBA PRO POLICI · 2026-2030</span>
      </div>

      <h1 class="h-display text-ink" style="font-size:clamp(56px, 9vw, 132px);line-height:1.2" set:html={HERO_HEADLINE_HTML} />

      <p class="mt-8 max-w-[560px] text-[18px] leading-[1.55] text-ink font-medium">
        {HERO_SUBTITLE}
      </p>

      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="#program" class="bg-ink text-primary hover:bg-paper hover:text-ink label text-[13px] px-7 py-4 inline-flex items-center gap-3 border-2 border-ink transition-colors duration-100">
          Přečíst program
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg>
        </a>
        <a href="#kandidati" class="bg-transparent text-ink border-2 border-ink hover:bg-ink hover:text-primary label text-[13px] px-7 py-4 inline-flex items-center gap-3 transition-colors duration-100">
          Naši kandidáti
        </a>
      </div>

    </div>

    <!-- Right: team photo -->
    <div class="lg:col-span-5 relative">
      <div class="relative" style="min-height:660px">
        <!-- decorative accent blocks -->
        <div class="absolute" style="right:0;top:0;width:88%;height:560px;background:#26A9AE"></div>
        <div class="absolute" style="left:0;top:480px;width:200px;height:100px;background:#002D52"></div>

        <!-- team photo frame -->
        <div class="absolute border-2 border-ink overflow-hidden bg-ink" style="left:30px;top:50px;right:0;height:520px">
          <Image src={TEAM_PHOTO} alt="[Tým ODS Police]" width={1200} height={800} class="w-full h-full object-cover" style="filter:grayscale(0.1) contrast(1.05)" />
          <div class="absolute bottom-0 left-0 right-0 bg-ink text-primary px-4 py-3 border-t-2 border-primary">
            <div class="label text-[10px] text-primary/80">NÁŠ TÝM</div>
            <div class="h-display text-[20px] leading-tight mt-1">17 OSOBNOSTÍ PRO POLICI</div>
          </div>
        </div>

        {/* Circle stamp — skryto, volební číslo zatím neznáme
        <div class="absolute" style="right:-10px;top:-20px">
          <div class="stamp relative bg-ink text-primary flex items-center justify-center border-4 border-primary" style="width:160px;height:160px">
            <svg viewBox="0 0 200 200" class="stamp absolute inset-0 stamp-spin" style="width:100%;height:100%">
              <defs>
                <path id="circle-text" d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
              </defs>
              <text style="font-size:14px;letter-spacing:0.28em;fill:#39D4D8;font-weight:600;font-family:Inter,sans-serif;text-transform:uppercase">
                <textPath href="#circle-text" startOffset="0">◆ ODS POLICE 2026 ◆ KOMUNÁLNÍ VOLBY ◆</textPath>
              </text>
            </svg>
            <div class="stamp text-center relative z-10">
              <div class="h-display text-primary text-[36px] leading-none">07</div>
              <div class="label text-primary text-[9px] mt-1">VOLEBNÍ ČÍSLO</div>
            </div>
          </div>
        </div>
        */}
      </div>

      <!-- Social links below team photo -->
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="#" class="bg-ink text-primary hover:bg-paper hover:text-ink label text-[13px] px-7 py-4 inline-flex items-center gap-3 border-2 border-ink transition-colors duration-100">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.7V4.6c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3z"/></svg>
          Facebook
        </a>
        <a href="#" class="bg-transparent text-ink border-2 border-ink hover:bg-ink hover:text-primary label text-[13px] px-7 py-4 inline-flex items-center gap-3 transition-colors duration-100">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
          </svg>
          @ODSPOLICE
        </a>
      </div>
    </div>
  </div>
</section>
