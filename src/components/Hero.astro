---
import { Image } from 'astro:assets';
import { TEAM_PHOTO, HERO_HEADLINE_HTML, HERO_SUBTITLE, CANDIDATES, SOCIAL } from '../data/content';
---
<section id="top" class="relative bg-primary border-b-2 border-ink overflow-hidden">
  <div class="absolute inset-0 grid-lines pointer-events-none"></div>

  <div class="relative max-w-[1280px] mx-auto px-6 lg:px-10 pt-16 pb-20 lg:pt-24 lg:pb-24">

    <!-- Headline -->
    <div class="grid lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3 mb-8">
          <span class="inline-block w-10 h-[3px] bg-ink"></span>
          <span class="label text-[12px] text-ink/80">VOLBA PRO POLICI · 2026-2030</span>
        </div>

        <h1 class="h-display text-ink" style="font-size:clamp(48px, 8vw, 116px);line-height:1.05" set:html={HERO_HEADLINE_HTML} />

        <p class="mt-8 max-w-[620px] text-[18px] leading-[1.55] text-ink font-medium">
          {HERO_SUBTITLE}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-wrap gap-4 lg:flex-col lg:items-stretch">
        <a href="#program" class="bg-ink text-primary hover:bg-paper hover:text-ink label text-[13px] px-7 py-4 inline-flex items-center justify-between gap-3 border-2 border-ink transition-colors duration-100">
          Přečíst program
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg>
        </a>
        <a href="#kandidati" class="bg-transparent text-ink border-2 border-ink hover:bg-ink hover:text-primary label text-[13px] px-7 py-4 inline-flex items-center justify-between gap-3 transition-colors duration-100">
          Naši kandidáti
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg>
        </a>
      </div>
    </div>

    <!-- Team photo, full width — a 17-person overhead shot needs the room -->
    <div class="relative mt-14 lg:mt-20">
      <div class="absolute bg-ink hidden sm:block" style="inset:0;transform:translate(12px,12px)"></div>
      <div class="relative border-2 border-ink bg-ink overflow-hidden">
        <Image src={TEAM_PHOTO} alt="Kandidáti ODS a nezávislí Police u kašny na náměstí" widths={[640, 960, 1280, 1600]} quality={62}
               sizes="(min-width: 1280px) 1200px, 100vw" loading="eager" fetchpriority="high"
               class="block w-full h-auto" style="filter:contrast(1.04) saturate(1.02)" />
        <div class="absolute bottom-0 left-0 bg-ink text-primary px-5 py-4 border-t-2 border-r-2 border-primary">
          <div class="label text-[10px] text-primary/80">NÁŠ TÝM</div>
          <div class="h-display text-[18px] sm:text-[24px] leading-tight mt-1">{CANDIDATES.length} OSOBNOSTÍ PRO POLICI</div>
        </div>
      </div>
    </div>

    <!-- Social links -->
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={SOCIAL.facebook} target="_blank" rel="noopener" class="bg-ink text-primary hover:bg-paper hover:text-ink label text-[13px] px-7 py-4 inline-flex items-center gap-3 border-2 border-ink transition-colors duration-100">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.7V4.6c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3z"/></svg>
        Facebook
      </a>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="bg-transparent text-ink border-2 border-ink hover:bg-ink hover:text-primary label text-[13px] px-7 py-4 inline-flex items-center gap-3 transition-colors duration-100">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
        </svg>
        Instagram
      </a>
    </div>
  </div>
</section>
