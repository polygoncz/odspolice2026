---
import { Image } from 'astro:assets';
import { PRIORITY_CARDS, PRIORITIES_INTRO } from '../data/content';
---
<section id="priority" class="bg-paper border-b-2 border-ink py-24">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
    <!-- SectionHeader -->
    <div class="max-w-[820px]">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-[3px] bg-primary"></span>
        <span class="label text-[11px] text-secondary">01 / PRIORITY</span>
      </div>
      <h2 class="h-display text-ink" style="font-size:clamp(40px, 6vw, 76px)">ŠEST PRIORIT</h2>
      <p class="mt-5 text-[16px] leading-[1.55] text-ink/75 max-w-[640px]">{PRIORITIES_INTRO}</p>
    </div>

    <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PRIORITY_CARDS.map(p => (
        <div class="relative">
          <div class="absolute bg-ink" style="inset:0;transform:translate(10px,10px)"></div>
          <div class="relative bg-paper border-2 border-ink p-7 flex flex-col overflow-hidden" style="min-height:280px">
            <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
              <Image src={p.bg} alt="" width={900} height={900} class="absolute inset-0 w-full h-full object-cover"
                   style="filter:grayscale(1) sepia(0.6) hue-rotate(180deg) saturate(2.8) brightness(0.95);opacity:0.22" />
              <div class="absolute inset-0" style="background:linear-gradient(to bottom right, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.6) 55%, rgba(255,255,255,0.35) 100%)"></div>
            </div>
            <div class="relative flex items-baseline justify-between">
              <span class="h-display text-primary text-[56px] leading-none">{p.n}</span>
              <span class="label text-[10px] text-secondary">PRIORITA</span>
            </div>
            <h3 class="relative h-display text-ink text-[26px] mt-6 tracking-tighter">{p.t}</h3>
            <p class="relative mt-4 text-[14px] leading-[1.55] text-ink/85 flex-1">{p.d}</p>
            <a href="#program" class="relative mt-6 label text-[11px] text-ink inline-flex items-center gap-2">
              <span class="border-b-2 border-primary pb-1">Více k bodu</span>
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
