---
import { Image } from 'astro:assets';
import { PRIORITY_CARDS, PRIORITIES_INTRO } from '../data/content';
---
<section id="priority" class="bg-paper border-b-2 border-ink py-24">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
    <!-- SectionHeader -->
    <div class="max-w-[820px]">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-[3px] bg-primary"></span>
        <span class="label text-[11px] text-secondary">01 / PRIORITY</span>
      </div>
      <h2 class="h-display text-ink" style="font-size:clamp(40px, 6vw, 76px)">ŠEST PRIORIT</h2>
      {PRIORITIES_INTRO && <p class="mt-5 text-[16px] leading-[1.55] text-ink/75 max-w-[640px]">{PRIORITIES_INTRO}</p>}
    </div>

    <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PRIORITY_CARDS.map(p => (
        <div class="relative">
          <div class="absolute bg-ink" style="inset:0;transform:translate(10px,10px)"></div>
          <div class="relative h-full bg-paper border-2 border-ink flex flex-col overflow-hidden">
            <div class="relative bg-ink border-b-2 border-ink overflow-hidden" style="aspect-ratio:16/10">
              <Image src={p.bg} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
                   class="absolute inset-0 w-full h-full object-cover" style="filter:contrast(1.05) saturate(0.95)" />
              <div class="absolute top-0 left-0 bg-primary text-ink px-3 py-2 border-r-2 border-b-2 border-ink">
                <span class="h-display text-[36px] leading-none">{p.n}</span>
              </div>
            </div>
            <div class="p-7 flex flex-col flex-1">
              <span class="label text-[10px] text-secondary">PRIORITA</span>
              <h3 class="h-display text-ink text-[26px] mt-3 tracking-tighter">{p.t}</h3>
              <p class="mt-4 text-[14px] leading-[1.55] text-ink/85 flex-1">{p.d}</p>
              <a href={`#program-${p.n}`} class="mt-6 label text-[11px] text-ink inline-flex items-center gap-2">
                <span class="border-b-2 border-primary pb-1">Více k bodu</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
