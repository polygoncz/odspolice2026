---
import { PHOTO_CREDITS } from '../data/content';
---
<footer class="bg-ink text-paper/60 border-t-2 border-primary">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="label text-[10px] text-paper/60">© 2026 ODS A NEZÁVISLÍ POLICE</div>
    <p class="text-[12px] leading-[1.6] max-w-[820px]">
      <span class="label text-[10px] text-primary mr-2">FOTOGRAFIE MĚSTA</span>
      Wikimedia Commons, barevně upraveno:
      {PHOTO_CREDITS.map((c, i) => (
        <span>
          <a href={c.sourceUrl} class="underline decoration-primary/40 hover:text-primary" target="_blank" rel="noopener">{c.what}</a>
          {' '}— {c.author},{' '}
          <a href={c.licenseUrl} class="hover:text-primary" target="_blank" rel="license noopener">{c.license}</a>{i < PHOTO_CREDITS.length - 1 ? '; ' : '.'}
        </span>
      ))}
    </p>
  </div>
</footer>
