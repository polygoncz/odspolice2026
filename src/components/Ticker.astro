---
const items = [
  'KOMUNÁLNÍ VOLBY • 3.–4. ŘÍJNA 2026',
  'PŘIDEJ SE K NÁM',
  'TRANSPARENTNÍ KAMPAŇ',
  'PROGRAM PRO POLICI',
  'KOMUNÁLNÍ VOLBY • 3.–4. ŘÍJNA 2026',
  'PŘIDEJ SE K NÁM',
  'TRANSPARENTNÍ KAMPAŇ',
  'PROGRAM PRO POLICI',
];
const doubled = [...items, ...items];
---
<div class="bg-ink text-primary border-b-2 border-ink overflow-hidden">
  <div class="ticker-track py-2 label text-[11px]">
    {doubled.map((t, i) => (
      <span class="flex items-center gap-12">
        <span>{t}</span>
        <span class="text-primary">◆</span>
      </span>
    ))}
  </div>
</div>
