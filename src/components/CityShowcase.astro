---
import { CITY_PHOTOS } from '../data/content';
---
<section class="bg-paper border-b-2 border-ink py-24">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10">

    <div class="grid lg:grid-cols-12 gap-8 mb-12 items-end">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-10 h-[3px] bg-primary"></span>
          <span class="label text-[12px] text-secondary">03 / MÍSTO</span>
        </div>
        <h2 class="h-display text-ink" style="font-size:clamp(40px, 6vw, 76px)">MĚSTO,&nbsp;KTERÉMU<br/>CHCEME SLOUŽIT</h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-[16px] leading-[1.6] text-ink/85 max-w-[460px]">
          [Krátký, osobní odstavec o vztahu k městu. Proč zrovna Police, co je nám tady cenné, co chceme zachovat — a co změnit.]
        </p>
        <div class="mt-6 inline-flex items-center gap-3 bg-ink text-primary px-4 py-2 border-2 border-ink">
          <span class="label text-[10px]">POLICE NAD METUJÍ</span>
          <span class="h-display text-[14px]">·</span>
          <span class="label text-[10px]">[X XXX OBYVATEL]</span>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="absolute bg-ink hidden lg:block" style="inset:0;transform:translate(12px,12px)"></div>
      <div class="relative grid lg:grid-cols-12 lg:grid-rows-3 gap-4" style="min-height:560px">
        {CITY_PHOTOS.map((p, i) => {
          const accent = String(i + 1).padStart(2, '0');
          const spanClass = i === 0
            ? 'lg:col-span-7 lg:row-span-3 min-h-[320px]'
            : 'lg:col-span-5 lg:row-span-1 min-h-[200px]';
          return (
            <div class={spanClass}>
              <div class="relative h-full bg-ink border-2 border-ink overflow-hidden">
                <img src={p.src} alt={p.cap} class="absolute inset-0 w-full h-full object-cover"
                     style="filter:grayscale(0.2) contrast(1.05)" loading="lazy" />
                <div class="absolute inset-0 bg-ink/15"></div>
                <div class="absolute bottom-0 left-0 right-0 bg-ink/90 text-paper px-4 py-3 border-t-2 border-primary z-10 flex items-end justify-between gap-3">
                  <div>
                    <div class="label text-[10px] text-primary">{p.meta}</div>
                    <div class="h-display text-[18px] leading-none mt-1">{p.cap}</div>
                  </div>
                  <div class="label text-[9px] text-primary/70 pb-[2px]">{accent}</div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t-2 border-ink pt-5">
      <div class="label text-[10px] text-secondary">[PLACEHOLDER FOTKY — NAHRADIT REÁLNÝMI ZÁBĚRY MĚSTA]</div>
      <a href="#program" class="label text-[11px] text-ink border-b-2 border-primary pb-1 hover:text-secondary">Podívat se na program →</a>
    </div>
  </div>
</section>
