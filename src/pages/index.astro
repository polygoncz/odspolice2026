---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import GroupPhoto from '../components/GroupPhoto.astro';
import Priorities from '../components/Priorities.astro';
import Candidates from '../components/Candidates.astro';
// import CityShowcase from '../components/CityShowcase.astro';
import ProgramAccordion from '../components/ProgramAccordion';
import Vision from '../components/Vision.astro';
import Credits from '../components/Credits.astro';
// import NewsEvents from '../components/NewsEvents.astro';
// import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { PROGRAM_ACCORDION, PROGRAM_INTRO, PRIORITY_CARDS } from '../data/content';
import '../styles/global.css';

const programChapters = await Promise.all(
  PROGRAM_ACCORDION.map(async ({ n, t, body, bg }) => ({
    n, t, body,
    alt: PRIORITY_CARDS.find(p => p.n === n)?.alt ?? '',
    image: (await getImage({ src: bg, width: 800, format: 'webp' })).src,
  }))
);
---
<Base>
  <Navbar />
  <main>
    <Hero />
    <GroupPhoto />
    <Priorities />
    <Candidates />
    <ProgramAccordion client:load chapters={programChapters} intro={PROGRAM_INTRO} />
    <Vision />
    {/* <CityShowcase /> */}
    {/* <NewsEvents /> */}
  </main>
  {/* <Footer /> */}
  <Credits />
</Base>
